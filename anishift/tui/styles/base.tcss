/* Base surfaces, typography and state classes shared by every screen. */

Screen {
    background: $background;
    color: $text;
}

.panel {
    background: $background-panel;
    padding: 1 2;
}

.panel-bordered {
    border: round $border;
}

.panel-bordered:focus-within {
    border: round $border-active;
}

.elevated {
    background: $background-element;
}

.row {
    height: 1;
}

/* Text hierarchy: primary content, secondary content, and group headings. */

.title {
    color: $text;
}

.label,
.muted {
    color: $text-muted;
}

.heading {
    color: $text;
    text-style: bold;
}

.group-heading {
    color: $accent;
    text-style: bold;
}

.accent {
    color: $primary;
}

/* Selection is background plus weight, never another hue. */

.selected {
    background: $primary;
    color: $on-primary;
}

.selected .title {
    color: $on-primary;
    text-style: bold;
}

.selected .label,
.selected .muted {
    color: $on-primary;
}

.disabled .title,
.disabled .label {
    color: $text-muted;
}

.state-success {
    color: $success;
}

.state-warning {
    color: $warning;
}

.state-error {
    color: $error;
}

.state-info {
    color: $info;
}

.compact .panel {
    padding: 0 1;
}

.compact .panel-bordered {
    border: none;
}

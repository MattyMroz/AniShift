/* Shared modal frame: one panel over the backdrop. */

DialogScreen {
    align: center top;
}

DialogScreen > #dialog-panel {
    height: auto;
    max-height: 100%;
    padding: 1 2;
    background: $background-panel;
}

#dialog-title {
    height: 1;
    color: $text;
    text-style: bold;
}

#dialog-escape {
    height: 1;
    width: auto;
    text-align: right;
    color: $text-muted;
}

.dialog-group-heading {
    height: 1;
    padding-left: 1;
    color: $accent;
    text-style: bold;
}

.dialog-hint,
.dialog-detail {
    height: 1;
    color: $text-muted;
}

.dialog-error {
    height: 1;
    color: $error;
}

DialogScreen OptionList {
    height: auto;
    max-height: 12;
    border: none;
    padding: 0;
    background: $background-panel;
    color: $text;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background-panel;
    scrollbar-color: $border;
    scrollbar-color-hover: $border-active;
    scrollbar-color-active: $border-active;
}

DialogScreen OptionList > .option-list--option {
    padding: 0;
}

DialogScreen OptionList > .option-list--option-hover {
    background: $background-panel;
}

DialogScreen OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $on-primary;
}

DialogScreen OptionList > .option-list--option-disabled {
    color: $text-muted;
}

DialogScreen Input {
    height: 1;
    border: none;
    padding: 0;
    background: $background-panel;
    background-tint: $background-panel 0%;
    color: $text;
}

DialogScreen Input > .input--cursor {
    background: $primary;
    color: $on-primary;
}

DialogScreen Input > .input--placeholder {
    color: $text-muted;
}

DialogScreen TextArea {
    height: 10;
    border: none;
    padding: 0;
    background: $background-panel;
    color: $text;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background-panel;
    scrollbar-color: $border;
    scrollbar-color-hover: $border-active;
    scrollbar-color-active: $border-active;
}

DialogScreen TextArea > .text-area--cursor {
    background: $primary;
    color: $on-primary;
}

DialogScreen TextArea > .text-area--cursor-line {
    background: $background-panel;
}

DialogScreen TextArea > .text-area--selection {
    background: $primary;
    color: $on-primary;
}

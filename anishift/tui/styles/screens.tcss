/* Application frame: the work area, the start block and the pinned bottom bar. */

$block-width: 80;

#app-body {
    height: 1fr;
    layout: vertical;
    background: $background;
}

#app-brand {
    width: 100%;
    height: auto;
    max-height: 4;
    margin-bottom: 1;
    text-align: center;
    background: $background;
}

#app-content {
    width: 100%;
    height: 1fr;
    min-height: 0;
    padding: 1 2;
    align: center middle;
    overflow-y: auto;
    background: $background;
}

#app-content > * {
    width: 100%;
    max-width: 100%;
    height: auto;
    text-align: center;
}

#app-detail {
    width: 40;
    padding: 1 2;
    background: $surface;
}

#app-spacer {
    width: 100%;
    height: 1fr;
    min-height: 0;
    background: $background;
}

#app-composer {
    width: 100%;
    height: auto;
    align-horizontal: center;
    background: $background;
}

#composer {
    width: $block-width;
    max-width: 100%;
    height: auto;
}

#composer-box {
    width: 100%;
    height: 3;
    background: $elevated;
}

#composer-accent {
    width: 2;
    height: 3;
    color: $focus;
    text-style: bold;
    background: $elevated;
}

#composer-body {
    width: 1fr;
    height: 3;
}

#composer-field {
    width: 100%;
    height: 1;
}

#composer-prompt {
    width: 2;
    color: $focus;
    text-style: bold;
    background: $elevated;
}

#composer-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $elevated;
    color: $text;
}

#composer-context {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    background: $elevated;
}

#composer-suggestions {
    height: auto;
    max-height: 10;
    border: none;
    padding: 0;
    background: $elevated;
}

#composer-suggestions > .option-list--option {
    padding: 0;
}

#composer-suggestions > .option-list--option-highlighted {
    background: $accent-soft;
    color: $text;
}

#composer-hint {
    height: 1;
    color: $text-muted;
}

#app-hints {
    width: 100%;
    height: auto;
    align-horizontal: center;
}

#app-keys {
    width: $block-width;
    max-width: 100%;
    height: 1;
    margin-top: 1;
    text-align: left;
    color: $text-muted;
}

#app-tip {
    width: $block-width;
    max-width: 100%;
    height: 1;
    margin-top: 1;
    padding-left: 5;
    text-align: left;
    color: $warning;
}

#app-footer {
    height: 1;
    padding: 0 1;
    background: $background;
    color: $text-muted;
}

#footer-location {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#footer-version {
    width: auto;
    height: 1;
    text-align: right;
    color: $text-muted;
}

.compact #app-brand {
    max-height: 1;
}

.compact #app-content {
    padding: 0 1;
}

.compact #app-detail {
    display: none;
}

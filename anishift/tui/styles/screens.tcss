/* Application frame: the work area, the start block and the pinned bottom bar. */

$block-width: 75;

Screen {
    layers: base popup;
}

#app-body {
    layer: base;
    height: 1fr;
    layout: vertical;
    background: $background;
}

#app-brand {
    width: 100%;
    height: auto;
    max-height: 6;
    margin-bottom: 2;
    text-align: center;
    text-wrap: nowrap;
    overflow-x: hidden;
    background: $background;
}

#app-content {
    width: 100%;
    height: 1fr;
    min-height: 0;
    padding: 1 2;
    align: center top;
    overflow-y: auto;
    background: $background;
}

#app-content > * {
    width: 100%;
    max-width: 100%;
    height: auto;
    text-align: center;
}

#app-content > #workspace-view {
    width: $block-width;
    max-width: 100%;
    height: auto;
    text-align: left;
}

#app-content > #tools-view {
    width: $block-width;
    max-width: 100%;
    height: auto;
    text-align: left;
}

#app-content > #auto-view {
    width: $block-width;
    max-width: 100%;
    height: auto;
    text-align: left;
}

#app-content > #manual-view {
    width: $block-width;
    max-width: 100%;
    height: auto;
    text-align: left;
}

#app-content > #preview-view {
    width: $block-width;
    max-width: 100%;
    height: auto;
    text-align: left;
}

#app-content > #execution-view {
    width: $block-width;
    max-width: 100%;
    height: auto;
    text-align: left;
}

#app-detail {
    width: 40;
    padding: 1 2;
    background: $background-panel;
}

#app-spacer {
    width: 100%;
    height: 1fr;
    min-height: 0;
    background: $background;
}

#app-composer {
    width: 100%;
    height: auto;
    align-horizontal: center;
    background: $background;
}

#composer {
    width: $block-width;
    max-width: 100%;
    height: auto;
}

#composer-box {
    width: 100%;
    height: 5;
    padding: 1 2 1 2;
    border-left: outer $secondary;
    background: $background-element;
}

#composer-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $background-element;
    background-tint: $background-element 0%;
    color: $text;
}

#composer-input > .input--cursor {
    background: $text;
    color: $background;
}

#composer-input > .input--placeholder {
    color: $text-muted;
}

#composer-input > .input--selection {
    background: $text;
    color: $background;
}

#composer-context {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    background: $background-element;
}

#composer-suggestions {
    layer: popup;
    position: absolute;
    width: $block-width;
    height: 10;
    border: none;
    padding: 0;
    background: $background-element;
    color: $text;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background-element;
    scrollbar-color: $border;
    scrollbar-color-hover: $border-active;
    scrollbar-color-active: $border-active;
}

#composer-suggestions > .option-list--option {
    padding: 0;
}

#composer-suggestions > .option-list--option-hover {
    background: $background-element;
}

#composer-suggestions > .option-list--option-highlighted {
    background: $primary;
    color: $on-primary;
}

#composer-hint {
    height: 1;
    color: $text-muted;
}

#app-hints {
    width: 100%;
    height: auto;
    align-horizontal: center;
}

#app-keys {
    width: $block-width;
    max-width: 100%;
    height: 1;
    text-align: left;
    color: $text-muted;
}

#app-tip {
    width: $block-width;
    max-width: 100%;
    height: 1;
    margin-top: 3;
    text-align: center;
    color: $text-muted;
}

#app-footer {
    layer: base;
    height: 1;
    padding: 0 1;
    background: $background;
    color: $text-muted;
}

#footer-location {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#footer-version {
    width: auto;
    height: 1;
    text-align: right;
    color: $text-muted;
}

.compact #app-brand {
    margin-bottom: 1;
}

.compact #app-tip {
    margin-top: 1;
}

.compact #app-content {
    padding: 0 1;
}

.compact #app-detail {
    display: none;
}

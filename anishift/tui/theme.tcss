Screen {
    background: #0b0f14;
    color: #e7edf3;
}

.route-content {
    height: 1fr;
    padding: 2 3;
}

.route-title {
    text-style: bold;
    color: #f08a72;
    margin-bottom: 1;
}

.placeholder-copy {
    height: 1fr;
    color: #9ba8b4;
}

#auto-options {
    grid-size: 2 4;
    grid-gutter: 1 2;
    height: 18;
}

#auto-products,
#auto-mkv-tracks {
    height: 6;
}

#intent-form {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1 2;
    height: 18;
}

#manual-products,
#manual-mkv-tracks {
    height: 6;
}

.screen-actions {
    height: 3;
}

#external-subtitle-fields,
#external-audio-fields {
    height: 3;
}

StartConfirmationScreen {
    align: center middle;
    background: #0008;
}

#start-confirmation {
    width: 64;
    height: 10;
    padding: 1 2;
    border: solid #f08a72;
    background: #151b22;
}

.small-terminal {
    height: 1fr;
    content-align: center middle;
    color: #f1c75b;
    display: none;
}

CommandBar {
    dock: bottom;
    height: 4;
    border-top: solid #384552;
    padding: 0 1;
}

#command-prompt {
    width: 3;
    height: 3;
    content-align: center middle;
    color: #f08a72;
    text-style: bold;
}

#command-input {
    width: 1fr;
}

#command-feedback {
    width: 36;
    height: 3;
    padding: 1;
    color: #9ba8b4;
}

#status-footer {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #151b22;
    color: #aeb8c2;
}
